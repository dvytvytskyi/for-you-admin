<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= property.name %> - Portfolio Analytics
    </title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

        :root {
            --primary: #1F2937;
            --accent: #D4AF37;
            --text-gray: #6B7280;
            --bg-gray: #F9FAFB;
            --success-green: #10B981;
            --brand-blue: #0F172A;
            /* Darker blue background */
        }

        @page {
            size: A4 landscape;
            margin: 0;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Outfit', sans-serif;
            color: var(--primary);
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .page {
            width: 297mm;
            height: 210mm;
            padding: 0;
            margin: 0;
            background: white;
            overflow: hidden;
            position: relative;
            page-break-after: always;
            box-sizing: border-box;
        }

        /* Cover Page */
        .cover-page {
            display: flex;
            background: var(--brand-blue);
            height: 100%;
            overflow: hidden;
        }

        .cover-sidebar {
            width: 35%;
            padding: 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: transparent;
            color: white;
            position: relative;
        }

        .cover-logo-area {
            position: absolute;
            top: 40px;
            left: 50px;
        }

        .cover-logo-img {
            width: 135px;
            height: auto;
            object-fit: contain;
        }

        .property-title {
            font-size: 24px;
            font-weight: 500;
            margin-bottom: 5px;
            color: #94A3B8;
            /* Muted gray-blue */
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .unit-subtitle {
            font-size: 56px;
            font-weight: 700;
            margin-bottom: 10px;
            color: white;
            line-height: 1;
        }

        .specs-grid-cover {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.2);
            padding-top: 30px;
        }

        .spec-item {
            display: flex;
            flex-direction: column;
        }

        .spec-label {
            font-size: 11px;
            text-transform: uppercase;
            opacity: 0.6;
            margin-bottom: 5px;
        }

        .spec-value {
            font-size: 20px;
            font-weight: 600;
        }

        .cover-image-container {
            width: 65%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 30px;
            box-sizing: border-box;
        }

        .cover-image {
            width: 100%;
            height: 85%;
            object-fit: cover;
            border-radius: 12px;
        }

        /* Detail Page */
        .detail-page {
            padding: 40px 50px;
            display: flex;
            flex-direction: column;
            height: 100%;
            box-sizing: border-box;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #E5E7EB;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

        .header-title {
            font-size: 24px;
            font-weight: 600;
        }

        .header-meta {
            color: var(--text-gray);
            font-size: 14px;
        }

        .analytics-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .metric-card {
            background: var(--bg-gray);
            padding: 25px;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
        }

        .metric-card.highlight {
            background: var(--brand-blue);
            color: white;
        }

        .metric-label {
            font-size: 12px;
            text-transform: uppercase;
            opacity: 0.8;
            margin-bottom: 10px;
        }

        .metric-value {
            font-size: 28px;
            font-weight: 700;
        }

        .metric-sub {
            font-size: 14px;
            opacity: 0.7;
            margin-top: 5px;
        }

        /* Documents Section */
        .documents-title {
            font-size: 18px;
            font-weight: 600;
            margin: 20px 0 15px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .documents-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .document-card {
            border: 1px solid #E5E7EB;
            padding: 15px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .doc-icon {
            width: 36px;
            height: 36px;
            background: #F3F4F6;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-gray);
        }

        .doc-info {
            flex-grow: 1;
        }

        .doc-name {
            font-weight: 500;
            font-size: 14px;
        }

        .doc-meta {
            font-size: 12px;
            color: var(--text-gray);
        }

        /* Gallery */
        .mixed-gallery {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            align-content: start;
        }

        .mixed-gallery img {
            width: 100%;
            aspect-ratio: 4 / 5;
            object-fit: cover;
            border-radius: 8px;
        }

        .contact-page {
            background: var(--brand-blue);
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .columns-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            height: 100%;
        }

        .data-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #F3F4F6;
            font-size: 14px;
        }

        .data-label {
            color: var(--text-gray);
        }

        .data-val {
            font-weight: 500;
        }
    </style>
</head>

<body>
    <!-- PAGE 1: COVER -->
    <div class="page cover-page">
        <div class="cover-sidebar">
            <div class="cover-logo-area">
                <img src="https://foryou-realestate.com/new%20logo.png" class="cover-logo-img">
            </div>

            <div style="margin-top: auto; margin-bottom: auto;">
                <% if(item.unitName) { %>
                    <div class="unit-subtitle">
                        <%= item.unitName %>
                    </div>
                    <% } %>
                        <div class="property-title">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.7;">
                                <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                                <path d="M9 22v-4h6v4"></path>
                                <path d="M8 6h.01"></path>
                                <path d="M16 6h.01"></path>
                                <path d="M8 10h.01"></path>
                                <path d="M16 10h.01"></path>
                                <path d="M8 14h.01"></path>
                                <path d="M16 14h.01"></path>
                            </svg>
                            <%= property.name %>
                                <% if (item.unitType) { %>(<%= item.unitType %>)<% } %>
                        </div>
                        <p style="opacity: 0.8; font-size: 18px;">
                            <%= property.area || property.city %>
                        </p>

                        <div class="specs-grid-cover">
                            <div class="spec-item">
                                <span class="spec-label">Purchase Price</span>
                                <span class="spec-value">$<%= Number(item.purchasePrice).toLocaleString() %></span>
                            </div>
                            <div class="spec-item">
                                <span class="spec-label">Current Value</span>
                                <span class="spec-value">$<%= Number(item.estimatedSellingValue).toLocaleString() %>
                                </span>
                            </div>
                            <div class="spec-item">
                                <span class="spec-label">ROI / Yield</span>
                                <span class="spec-value" style="color: var(--accent);">+<%= item.roi %>%</span>
                            </div>
                            <div class="spec-item">
                                <span class="spec-label">Status</span>
                                <span class="spec-value">
                                    <%= item.operationalStatus %>
                                </span>
                            </div>
                        </div>
            </div>

            <div style="font-size: 12px; opacity: 0.5; margin-top: auto;">
                Investment Portfolio Analytics Report
            </div>
        </div>

        <div class="cover-image-container">
            <% if (property.photos && property.photos.length> 0) { %>
                <img src="<%= property.photos[0] %>" class="cover-image">
                <% } else if (item.photos && item.photos.length> 0) { %>
                    <img src="<%= item.photos[0] %>" class="cover-image">
                    <% } %>
        </div>
    </div>

    <!-- PAGE 2: OVERVIEW -->
    <div class="page detail-page">
        <div class="page-header">
            <div class="header-title">Unit Overview</div>
            <div class="header-meta">REF: <%= item.id.split('-')[0].toUpperCase() %>
            </div>
        </div>

        <div class="columns-2">
            <div>
                <div style="font-size: 18px; font-weight: 600; margin-bottom: 20px;">Detailed Specifications</div>
                <div class="data-row"><span class="data-label">Type</span> <span class="data-val">
                        <%= item.unitType || '-' %>
                    </span></div>
                <div class="data-row"><span class="data-label">Size</span> <span class="data-val">
                        <%= item.size ? item.size + ' sqm' : '-' %>
                    </span></div>
                <div class="data-row"><span class="data-label">Acquisition</span> <span class="data-val">
                        <%= item.purchaseDate || '-' %>
                    </span></div>
                <div class="data-row"><span class="data-label">Planned Exit</span> <span class="data-val">
                        <%= item.plannedSaleDate || '-' %>
                    </span></div>

                <div style="margin-top: 30px; font-size: 13px; color: var(--text-gray); line-height: 1.6;">
                    <%= property.description ? property.description.substring(0, 500) + '...'
                        : 'Project details and unit features as per the investment plan.' %>
                </div>
            </div>

            <div>
                <% if (item.floorPlans && item.floorPlans.length> 0) { %>
                    <div style="font-size: 18px; font-weight: 600; margin-bottom: 15px; margin-top: 10px;">Floor Plans
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px;">
                        <% item.floorPlans.slice(0, 2).forEach(function(url) { %>
                            <img src="<%= url %>"
                                style="width: 100%; aspect-ratio: 4/3; object-fit: contain; border-radius: 8px; background: #f9f9f9; border: 1px solid #eee;">
                            <% }); %>
                    </div>
                    <% } %>

                        <% if (item.photos && item.photos.length> 0) { %>
                            <div style="font-size: 18px; font-weight: 600; margin-bottom: 15px;">Unit Photos</div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                <% item.photos.slice(0, 4).forEach(function(url) { %>
                                    <img src="<%= url %>"
                                        style="width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 8px;">
                                    <% }); %>
                            </div>
                            <% } %>

                                <% if ((!item.floorPlans || item.floorPlans.length===0) && (!item.photos ||
                                    item.photos.length===0)) { %>
                                    <div style="font-size: 18px; font-weight: 600; margin-bottom: 20px;">Unit Gallery
                                    </div>
                                    <div
                                        style="color: var(--text-gray); font-style: italic; padding: 20px; text-align: center; border: 1px dashed #E5E7EB; border-radius: 8px;">
                                        No unit specific photos available.
                                    </div>
                                    <% } %>
            </div>
        </div>
    </div>

    <!-- PAGE 3: ANALYTICS -->
    <div class="page detail-page">
        <div class="page-header">
            <div class="header-title">Performance Analytics</div>
            <div class="header-meta">Report Date: <%= new Date().toLocaleDateString() %>
            </div>
        </div>

        <div class="analytics-grid">
            <div class="metric-card highlight">
                <span class="metric-label">Total Appreciation</span>
                <span class="metric-value">+<%= item.appreciation %>%</span>
                <span class="metric-sub">Value Growth: $<%= (item.estimatedSellingValue -
                        item.purchasePrice).toLocaleString() %></span>
            </div>
            <div class="metric-card">
                <span class="metric-label">Current Valuation</span>
                <span class="metric-value">$<%= Number(item.estimatedSellingValue).toLocaleString() %></span>
                <span class="metric-sub">Initial Investment: $<%= Number(item.purchasePrice).toLocaleString() %></span>
            </div>
            <div class="metric-card">
                <span class="metric-label">Annual Cash Flow</span>
                <span class="metric-value">$<%= Number(item.annualCashFlow).toLocaleString() %></span>
                <span class="metric-sub">Yield: <span style="color: var(--success-green); font-weight: 600;">
                        <%= item.roi %>%
                    </span></span>
            </div>
        </div>

        <div class="documents-title">Associated Documents</div>
        <% if (item.documents && item.documents.length> 0) { %>
            <div class="documents-list">
                <% item.documents.forEach(function(doc) { %>
                    <div class="document-card">
                        <div class="doc-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                        </div>
                        <div class="doc-info">
                            <div class="doc-name">
                                <%= doc.name %>
                            </div>
                            <div class="doc-meta">
                                <%= doc.description || 'Verified Document' %>
                            </div>
                        </div>
                        <div style="font-size: 10px; color: var(--accent); font-weight: 700;">PDF</div>
                    </div>
                    <% }); %>
            </div>
            <% } else { %>
                <div
                    style="color: var(--text-gray); font-style: italic; padding: 20px; text-align: center; border: 1px dashed #E5E7EB; border-radius: 8px;">
                    No documents attached to this investment.</div>
                <% } %>

                    <div
                        style="margin-top: auto; padding: 15px; background: #FFFBEB; border-radius: 8px; font-size: 13px;">
                        <strong>Advisor Note:</strong> This report is based on current market estimates and data
                        provided by <%= property.developer || 'the developer' %>. Please contact your personal advisor
                            for live updates via WhatsApp: <%= item.advisorWhatsapp || '+971 50 123 4567' %>.
                    </div>
    </div>

    <!-- PAGE 4: GALLERY -->
    <% let galleryPhotos=[]; if (item.photos && item.photos.length> 1) galleryPhotos =
        galleryPhotos.concat(item.photos.slice(1));
        if (property.photos && property.photos.length > 5) galleryPhotos =
        galleryPhotos.concat(property.photos.slice(5));
        const finalGallery = galleryPhotos.slice(0, 8);
        %>

        <% if (finalGallery.length> 0) { %>
            <div class="page detail-page">
                <div class="page-header">
                    <div class="header-title">Gallery & Media</div>
                </div>
                <div class="mixed-gallery">
                    <% finalGallery.forEach(function(url) { %>
                        <img src="<%= url %>">
                        <% }); %>
                </div>
            </div>
            <% } %>

                <div class="page contact-page">
                    <h2 style="font-size: 36px; margin-bottom: 20px;">For You Real Estate</h2>
                    <div style="width: 60px; height: 3px; background: var(--accent); margin-bottom: 30px;"></div>
                    <div style="font-size: 24px; font-weight: 600; margin-bottom: 5px;">Investment Department</div>
                    <div style="font-size: 18px; opacity: 0.9;">+971 50 123 4567 | info@foryou.ae</div>
                    <div style="margin-top: 40px; font-size: 14px; opacity: 0.7;">www.foryou-realestate.com</div>
                    <div style="position: absolute; bottom: 50px;">
                        <img src="https://foryou-realestate.com/new%20logo.png" style="width: 140px; opacity: 0.8;">
                    </div>
                </div>
</body>

</html>
#!/usr/bin/expect -f
set timeout 600
set password "xTVvPEwrpaF4"

# 1. Restart Backend
spawn ssh -o StrictHostKeyChecking=no root@135.181.201.185 "cd /root/admin-panel && docker-compose -f docker-compose.prod.yml stop admin-panel-backend && docker-compose -f docker-compose.prod.yml rm -f admin-panel-backend && docker-compose -f docker-compose.prod.yml up -d admin-panel-backend"
expect "password:" { send "$password\r" }
expect eof

# 2. Rebuild and Restart Frontend (it takes longer)
spawn ssh -o StrictHostKeyChecking=no root@135.181.201.185 "cd /root/admin-panel && docker-compose -f docker-compose.prod.yml stop admin-panel-frontend && docker-compose -f docker-compose.prod.yml rm -f admin-panel-frontend && docker-compose -f docker-compose.prod.yml up -d --build admin-panel-frontend"
expect "password:" { send "$password\r" }
expect eof

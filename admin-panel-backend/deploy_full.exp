#!/usr/bin/expect -f
set timeout 300
set password "xTVvPEwrpaF4"

set server "root@135.181.201.185"

# 1. Sync backend code (using rsync for speed)
spawn rsync -avz --exclude 'node_modules' --exclude 'dist' --exclude '.git' /Users/vytvytskyi/admin_for_you/admin-panel-backend/ $server:/root/admin-panel/admin-panel-backend/
expect "password:" { send "$password\r" }
expect eof

# 2. Sync frontend code
spawn rsync -avz --exclude 'node_modules' --exclude '.next' --exclude '.git' /Users/vytvytskyi/admin_for_you/admin-panel/ $server:/root/admin-panel/admin/
expect "password:" { send "$password\r" }
expect eof

# 3. Rebuild Containers
spawn ssh -o StrictHostKeyChecking=no $server "cd /root/admin-panel && docker-compose -f docker-compose.prod.yml up -d --build"
expect "password:" { send "$password\r" }
expect eof
